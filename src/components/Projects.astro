---
import { Icon } from 'astro-icon/components';
import { projects } from '../data/profile';

// Four projects, four cells: one wide feature, one tinted, one with imagery,
// one plain. Column spans are declared per index so the grid never has a hole.
const spans = ['md:col-span-4', 'md:col-span-2', 'md:col-span-3', 'md:col-span-3'];

// The Pages workflow passes --base at build time, so site-internal paths have
// to be resolved against it. External URLs and anchors are left alone.
const base = import.meta.env.BASE_URL;
const resolve = (path: string) =>
  path.startsWith('/') ? `${base.replace(/\/$/, '')}/${path.replace(/^\//, '')}` : path;
---

<section id="projects" class="mx-auto max-w-6xl px-5 py-20 sm:px-8 sm:py-28">
  <h2 class="display reveal text-3xl text-ink sm:text-4xl">Selected projects</h2>

  <div class="mt-10 grid grid-cols-1 gap-4 md:grid-cols-6">
    {
      projects.map((project, index) => (
        <a
          href={resolve(project.href)}
          style={`--index:${index}`}
          class:list={[
            'reveal group flex flex-col overflow-hidden rounded-[12px] border border-line transition-shadow duration-200 hover:shadow-[0_2px_8px_rgba(0,0,0,0.04)]',
            spans[index],
            project.tinted ? 'bg-accent-soft' : 'bg-surface',
          ]}
        >
          {project.image && (
            <img
              src={resolve(project.image)}
              alt={project.imageAlt}
              loading="lazy"
              decoding="async"
              class:list={[
                'w-full object-cover opacity-95 saturate-[0.7] transition-transform duration-500 group-hover:scale-[1.02]',
                project.feature ? 'aspect-[16/9]' : 'aspect-[3/2]',
              ]}
            />
          )}

          <div class="flex flex-1 flex-col p-6 sm:p-8">
            <h3 class="font-serif text-2xl tracking-[-0.02em] text-ink">{project.name}</h3>
            <p class="mt-3 max-w-[46ch] text-sm text-ink-soft">{project.summary}</p>

            <div class="mt-6 flex flex-wrap items-center gap-2">
              {project.tags.map((tag) => (
                <span class="rounded-full border border-line px-3 py-1 text-[11px] tracking-[0.05em] text-ink-soft uppercase">
                  {tag}
                </span>
              ))}
            </div>

            <span
              class="mt-auto inline-flex items-center gap-1.5 pt-8 text-sm font-medium text-accent"
            >
              Read more
              <Icon
                name="ph:arrow-up-right-bold"
                class="size-3.5 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
              />
            </span>
          </div>
        </a>
      ))
    }
  </div>
</section>
