---
import Base from '../../layouts/Base.astro';
import { Icon } from 'astro-icon/components';

const base = import.meta.env.BASE_URL;
---

<Base
  title="UWA unit prerequisites - a graph of the handbook"
  description="Every UWA unit and its prerequisites, drawn as a dependency graph you can scope to a single major."
>
  <main class="mx-auto w-full max-w-[1400px] px-5 pt-10 pb-24 sm:px-8 md:pt-14">
    <header class="reveal max-w-3xl" style="--index:0">
      <a
        href={`${base}#projects`}
        class="meta inline-flex items-center gap-1.5 transition-colors hover:text-ink"
      >
        <Icon name="ph:arrow-left-bold" class="h-3 w-3" />
        Back to projects
      </a>

      <h1 class="display mt-4 text-4xl sm:text-5xl">UWA unit prerequisites</h1>

      <p class="mt-4 max-w-[65ch] text-ink-soft">
        Pick a major and read it as a dependency graph, with an arrow running from each
        prerequisite to the unit it unlocks.
      </p>

      <!--
        The caveat matters, but it is reference material rather than something to
        re-read on every visit, so it collapses and keeps the graph above the fold.
      -->
      <details class="group mt-3 max-w-[65ch]">
        <summary
          class="meta inline-flex cursor-pointer list-none items-center gap-1.5 transition-colors hover:text-ink"
        >
          <span class="text-base leading-none group-open:hidden">+</span>
          <span class="hidden text-base leading-none group-open:inline">-</span>
          What an arrow does and does not mean
        </summary>
        <p class="mt-2 border-l border-line pl-4 text-sm leading-relaxed text-ink-soft">
          Prerequisite rules are written as sentences, and many of them mix "and" with
          "or" in ways a diagram cannot honestly capture. An arrow here means only that a
          unit is named somewhere in another unit's prerequisite rule. Dotted arrows are
          advisable prior study, which the handbook recommends but does not enforce: you
          can enrol without them. Select any unit to read the rule exactly as the handbook
          words it, and treat the handbook as authoritative.
        </p>
      </details>
    </header>

    <!-- Controls -->
    <section
      class="reveal mt-6 rounded-[var(--radius-card)] border border-line bg-surface p-4 sm:p-5"
      style="--index:1"
      aria-label="Graph controls"
    >
      <div class="grid gap-4 md:grid-cols-[minmax(0,2fr)_minmax(0,2fr)] md:items-end">
        <div>
          <label for="major" class="meta mb-1.5 block text-ink-soft">Major</label>
          <select
            id="major"
            class="w-full rounded-[var(--radius-control)] border border-line bg-canvas px-3 py-2 text-sm text-ink"
          >
            <option value="">Loading majors</option>
          </select>
          <!--
            Several majors share a name with a different unit map, so the code,
            kind and entry prerequisite of the selected one are spelled out here.
          -->
          <p id="major-meta" class="mt-1.5 text-xs leading-relaxed text-ink-soft"></p>
        </div>

        <div>
          <label for="unit-search" class="meta mb-1.5 block text-ink-soft">
            Find a unit in this major
          </label>
          <input
            id="unit-search"
            type="search"
            list="unit-options"
            autocomplete="off"
            placeholder="CITS3007"
            class="w-full rounded-[var(--radius-control)] border border-line bg-canvas px-3 py-2 text-sm text-ink placeholder:text-muted"
          />
          <datalist id="unit-options"></datalist>
        </div>

        <div class="grid gap-2 sm:grid-cols-2 md:col-span-2">
          <label
            class="flex cursor-pointer items-center gap-2.5 rounded-[var(--radius-control)] border border-line bg-canvas px-3 py-2 text-sm text-ink-soft"
          >
            <input id="include-outside" type="checkbox" checked class="accent-accent" />
            Include prerequisites outside the major
          </label>

          <label
            class="flex cursor-pointer items-center gap-2.5 rounded-[var(--radius-control)] border border-line bg-canvas px-3 py-2 text-sm text-ink-soft"
          >
            <input id="include-advisable" type="checkbox" checked class="accent-accent" />
            Show advisable prior study
          </label>
        </div>
      </div>

      <div class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-2 border-t border-line pt-4">
        <span class="tag" style="background:var(--tag-core-bg);color:var(--tag-core-fg)">
          Compulsory
        </span>
        <span class="tag" style="background:var(--tag-option-bg);color:var(--tag-option-fg)">
          Option
        </span>
        <span class="tag" style="background:var(--surface-tint);color:var(--muted)">
          Outside the major
        </span>
        <span class="meta">
          Solid arrow: prerequisite. Dashed: co-requisite. Dotted: advisable prior study.
        </span>
      </div>
    </section>

    <!-- Status region: loading, error, and empty all render here -->
    <div id="status" class="mt-6" role="status" aria-live="polite"></div>

    <!-- Graph plus detail panel -->
    <section id="workspace" class="mt-6 hidden gap-5 lg:grid lg:grid-cols-[minmax(0,1fr)_360px]">
      <div
        id="graph-shell"
        class="relative overflow-hidden rounded-[var(--radius-card)] border border-line bg-surface"
      >
        <div id="cy" class="h-[68vh] min-h-[460px] w-full"></div>
        <button
          id="fit"
          type="button"
          class="absolute top-3 right-3 rounded-[var(--radius-control)] border border-line bg-surface px-3 py-1.5 text-xs text-ink-soft transition-colors hover:text-ink"
        >
          Fit to view
        </button>
      </div>

      <aside
        id="detail"
        class="rounded-[var(--radius-card)] border border-line bg-surface p-5 lg:max-h-[68vh] lg:overflow-y-auto"
      >
      </aside>
    </section>

    <!--
      Under lg the canvas is unusable, so the same data renders as a list grouped
      by level with prerequisites inline. The graph stays reachable full screen.
    -->
    <section id="compact" class="mt-6 hidden">
      <button
        id="open-graph"
        type="button"
        class="mb-5 flex w-full items-center justify-center gap-2 rounded-[var(--radius-control)] border border-line bg-surface px-4 py-2.5 text-sm text-ink transition-colors hover:bg-surface-tint"
      >
        <Icon name="ph:graph-bold" class="h-4 w-4" />
        Open the graph full screen
      </button>
      <div id="compact-list" class="grid gap-4"></div>
    </section>

    <!-- Full-screen graph for small viewports -->
    <div
      id="overlay"
      class="fixed inset-0 z-50 hidden flex-col bg-canvas"
      role="dialog"
      aria-modal="true"
      aria-label="Prerequisite graph"
    >
      <div class="flex items-center justify-between border-b border-line px-4 py-3">
        <span class="meta" id="overlay-title">Prerequisite graph</span>
        <div class="flex items-center gap-2">
          <button
            id="fit-mobile"
            type="button"
            class="rounded-[var(--radius-control)] border border-line px-3 py-1.5 text-xs text-ink-soft"
          >
            Fit
          </button>
          <button
            id="close-graph"
            type="button"
            class="rounded-[var(--radius-control)] border border-line px-3 py-1.5 text-xs text-ink"
          >
            Close
          </button>
        </div>
      </div>
      <div id="cy-mobile" class="min-h-0 flex-1"></div>
      <!--
        Tapping a node has to lead somewhere. The desktop detail panel is moved
        in here as a sheet while the overlay is open rather than duplicated, so
        both views render from the same markup.
      -->
      <div
        id="overlay-detail"
        class="max-h-[42vh] shrink-0 overflow-y-auto border-t border-line bg-surface"
      >
      </div>
    </div>

    <footer class="reveal mt-12 border-t border-line pt-6" style="--index:2">
      <p class="meta max-w-[65ch] leading-relaxed">
        Unit and major data comes from the UWA Handbook at handbooks.uwa.edu.au and is
        refreshed by hand when the handbook rolls over. <span id="provenance"></span> The
        handbook is the authoritative source; this page is a reading aid and can be out of
        date or wrong.
      </p>
    </footer>
  </main>

  <script src="../../scripts/uwa-graph.ts"></script>
</Base>
